{
  "name": "bh-web",
  "version": "0.1.0",
  "packageManager": "npm@10.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib hooks --ext .ts,.tsx,.js,.jsx --config eslint.config.mjs",
    "lint:fix": "eslint app components lib hooks --ext .ts,.tsx,.js,.jsx --config eslint.config.mjs --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "check-vercel": "node scripts/check-vercel-config.js",
    "seed": "npx tsx scripts/seed.ts"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@next/bundle-analyzer": "^16.2.4",
    "@react-pdf/renderer": "^4.3.1",
    "@sentry/nextjs": "^10.44.0",
    "@supabase/auth-helpers-nextjs": "0.15.0",
    "@supabase/auth-helpers-react": "0.15.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "2.87.1",
    "@types/qrcode": "^1.5.6",
    "@vercel/speed-insights": "^1.3.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.35.1",
    "lucide-react": "^0.469.0",
    "next": "^16.1.6",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.23",
    "@types/papaparse": "^5.5.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.9.19",
    "dotenv": "^16.4.5",
    "eslint": "^9",
    "eslint-config-next": "15.5.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.4.0",
    "pg": "^8.17.2",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write"
  }
}
